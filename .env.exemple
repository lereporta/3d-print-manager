# ════════════════════════════════════════════════════════════
#  3D PRINT MANAGER — Variáveis de Ambiente
#  Copie para `.env` e ajuste os valores antes de subir.
#  NUNCA versione o arquivo .env real no Git.
# ════════════════════════════════════════════════════════════

# ── Aplicação ───────────────────────────────────────────────
APP_NAME="3D Print Manager"
APP_ENV=development              # development | staging | production
DEBUG=true

# ── Banco de Dados ──────────────────────────────────────────
# Para SQLite local (padrão de testes):
DATABASE_URL=sqlite:///./data/print_manager.db
# Exemplo Postgres (produção futura):
# DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/print_manager

# ── Segurança JWT ───────────────────────────────────────────
# IMPORTANTE: gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-de-64-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 dias (7 * 24 * 60)

# ── Admin Seeding (criado automaticamente no primeiro boot) ─
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@printmanager.local
ADMIN_PASSWORD=ChangeMe!2026

# ── CORS (opcional, para frontends externos) ────────────────
CORS_ORIGINS=http://localhost,http://localhost:8000

