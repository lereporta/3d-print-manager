// ===================================================================
//  3D Print Manager — Frontend Logic v5.0 (Lote + Unit + DOM Fix)
// ===================================================================

document.addEventListener('DOMContentLoaded', () => {
    initTheme();
    initMobileMenu();
    initLocalStoragePersistence();
    initSupplies();
    initValueMultiplier();
    initSimulator();
    initCalculator();
    initToasts();
    initButtonFeedback();

    // Cálculo inicial
    calculate();

    requestAnimationFrame(() => {
        document.body.classList.remove('no-transitions');
    });
});

// ===================================================================
//  THEME
// ===================================================================
function initTheme() {
    const saved = localStorage.getItem('theme');
    if (saved === 'dark') {
        document.documentElement.classList.add('dark');
    } else if (saved === 'light') {
        document.documentElement.classList.remove('dark');
    }

    document.querySelectorAll('.theme-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
    });
}

// ===================================================================
//  MOBILE MENU
// ===================================================================
function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!btn || !sidebar) return;

    btn.addEventListener('click', () => {
        sidebar.classList.toggle('open');
        if (overlay) overlay.classList.toggle('hidden');
    });

    if (overlay) {
        overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.add('hidden');
        });
    }
}

// ===================================================================
//  LOCALSTORAGE PERSISTENCE
// ===================================================================
function initLocalStoragePersistence() {
    const fields = [
        { id: 'filament_price_kg',     key: 'pm_filament_price_kg' },
        { id: 'depreciation_per_hour', key: 'pm_depreciation_per_hour' },
        { id: 'labor_per_hour',        key: 'pm_labor_per_hour' },
        { id: 'risk_rate',             key: 'pm_risk_rate' },
        { id: 'margin_percent',        key: 'pm_margin_percent' },
    ];

    fields.forEach(({ id, key }) => {
        const el = document.getElementById(id);
        if (!el) return;
        const saved = localStorage.getItem(key);
        if (saved !== null && saved !== '') el.value = saved;
        el.addEventListener('input', () => localStorage.setItem(key, el.value));
    });
}

// ===================================================================
//  SUPPLIES (Insumos de Montagem)
// ===================================================================
let supplyCounter = 0;

function initSupplies() {
    const addBtn = document.getElementById('add-supply-btn');
    if (!addBtn) return;

    const newBtn = addBtn.cloneNode(true);
    addBtn.parentNode.replaceChild(newBtn, addBtn);
    newBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        addSupplyRow();
    });
}

function addSupplyRow() {
    supplyCounter++;
    const container = document.getElementById('supplies-container');
    if (!container) return;

    const rowId = `supply-row-${supplyCounter}`;
    const row = document.createElement('div');
    row.className = 'supply-row';
    row.id = rowId;
    row.setAttribute('data-supply-row', 'true');

    row.innerHTML = `
        <div>
            <label class="block text-xs font-semibold mb-1 text-gray-500">Insumo</label>
            <input type="text" placeholder="Ex: Argola chaveiro"
                   class="input-field text-xs py-1.5" data-supply="name">
        </div>
        <div>
            <label class="block text-xs font-semibold mb-1 text-gray-500">Custo Pacote</label>
            <div class="input-group">
                <span class="input-prefix">R$</span>
                <input type="number" step="0.01" min="0" value="0"
                       class="input-field has-prefix text-xs py-1.5"
                       data-supply="package_cost">
            </div>
        </div>
        <div>
            <label class="block text-xs font-semibold mb-1 text-gray-500">Qtd Pacote</label>
            <input type="number" step="1" min="1" value="1"
                   class="input-field text-xs py-1.5"
                   data-supply="package_qty">
        </div>
        <div>
            <label class="block text-xs font-semibold mb-1 text-gray-500">Qtd/Peça</label>
            <input type="number" step="1" min="0" value="1"
                   class="input-field text-xs py-1.5"
                   data-supply="per_piece">
        </div>
        <div class="flex items-end pb-1">
            <button type="button"
                    class="supply-remove-btn p-1.5 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-red-400 hover:text-red-600"
                    data-remove-row="${rowId}" title="Remover insumo">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    `;

    container.appendChild(row);

    row.querySelectorAll('input[type="number"]').forEach(input => {
        input.addEventListener('input', () => recalculateAllSupplies());
    });

    row.querySelector('.supply-remove-btn').addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById(e.currentTarget.getAttribute('data-remove-row'))?.remove();
        updateSuppliesPlaceholder();
        recalculateAllSupplies();
    });

    updateSuppliesPlaceholder();
    recalculateAllSupplies();
}

function updateSuppliesPlaceholder() {
    const container = document.getElementById('supplies-container');
    const placeholder = document.getElementById('supplies-placeholder');
    const totalBar = document.getElementById('supplies-total-bar');
    const badge = document.getElementById('supply-count');
    if (!container) return;

    const count = container.querySelectorAll('[data-supply-row]').length;
    if (placeholder) placeholder.style.display = count === 0 ? 'block' : 'none';
    if (totalBar)    totalBar.classList.toggle('hidden', count === 0);
    if (badge) {
        badge.textContent = count > 0 ? `${count} insumo${count !== 1 ? 's' : ''}` : '';
        badge.classList.toggle('hidden', count === 0);
    }
}

function recalculateAllSupplies() {
    const container = document.getElementById('supplies-container');
    if (!container) return;

    let total = 0;
    container.querySelectorAll('[data-supply-row]').forEach(row => {
        const pkgCost  = parseFloat(row.querySelector('[data-supply="package_cost"]')?.value) || 0;
        const pkgQty   = parseFloat(row.querySelector('[data-supply="package_qty"]')?.value) || 1;
        const perPiece = parseFloat(row.querySelector('[data-supply="per_piece"]')?.value) || 0;
        total += (pkgQty > 0 ? pkgCost / pkgQty : 0) * perPiece;
    });

    setVal('supplies_cost', total.toFixed(4));

    const stv = document.getElementById('supplies-total-value');
    if (stv) stv.textContent = formatCurrency(total);

    calculate();
}

// ===================================================================
//  VALUE MULTIPLIER (Peça Técnica)
// ===================================================================
function initValueMultiplier() {
    const toggle = document.getElementById('value-toggle');
    const panel  = document.getElementById('value-multiplier-panel');
    const input  = document.getElementById('value_multiplier_input');
    const hidden = document.getElementById('value_multiplier');
    if (!toggle || !panel) return;

    toggle.addEventListener('click', () => {
        const isActive = toggle.classList.toggle('active');
        panel.style.display = isActive ? 'block' : 'none';
        if (!isActive) {
            if (input)  input.value  = '1';
            if (hidden) hidden.value = '1';
        } else {
            if (hidden && input) hidden.value = input.value;
        }
        calculate();
    });

    if (input) {
        input.addEventListener('input', () => {
            let v = parseFloat(input.value) || 1;
            if (v < 1) v = 1;
            if (hidden) hidden.value = v;
            calculate();
        });
    }
}

// ===================================================================
//  SIMULATOR (Revenda / Atacado) — FIX #3: usa custo UNITÁRIO
// ===================================================================
function initSimulator() {
    const r = document.getElementById('sim_retail_price');
    const w = document.getElementById('sim_wholesale_price');
    if (r) r.addEventListener('input', updateSimulator);
    if (w) w.addEventListener('input', updateSimulator);
}

function updateSimulator() {
    // ★ Usa custo UNITÁRIO, não do lote inteiro
    const unitCost       = _lastUnitCost || 0;
    const retailPrice    = getNum('sim_retail_price');
    const wholesalePrice = getNum('sim_wholesale_price');

    // Lucro por peça
    const yourProfit     = wholesalePrice - unitCost;
    const resellerProfit = retailPrice - wholesalePrice;

    // Textos
    const ypEl = document.getElementById('sim_your_profit');
    if (ypEl) {
        ypEl.textContent = formatCurrency(yourProfit);
        ypEl.className = 'text-lg font-extrabold ' +
            (yourProfit >= 0 ? 'text-emerald-500' : 'text-red-500');
    }

    const rpEl = document.getElementById('sim_reseller_profit');
    if (rpEl) {
        rpEl.textContent = formatCurrency(resellerProfit);
        rpEl.className = 'text-lg font-extrabold ' +
            (resellerProfit >= 0 ? 'text-indigo-500' : 'text-red-500');
    }

    // Alerta de prejuízo — compara com custo UNITÁRIO
    const alertEl = document.getElementById('sim_alert');
    if (alertEl) {
        alertEl.style.display =
            (wholesalePrice > 0 && wholesalePrice < unitCost) ? 'flex' : 'none';
    }

    // Barras visuais
    const maxVal   = Math.max(Math.abs(yourProfit), Math.abs(resellerProfit), 0.01);
    const hasInput = retailPrice > 0 || wholesalePrice > 0;

    renderBar('sim_your_bar',      yourProfit,     maxVal, hasInput, yourProfit >= 0 ? 'profit' : 'loss');
    renderBar('sim_reseller_bar',  resellerProfit, maxVal, hasInput, resellerProfit >= 0 ? 'reseller' : 'loss');

    updateVolumeTable();
}

function renderBar(id, value, maxVal, hasInput, cls) {
    const bar = document.getElementById(id);
    if (!bar) return;
    const pct = Math.max(5, Math.min(100, (Math.abs(value) / maxVal) * 100));
    bar.style.width   = hasInput ? pct + '%' : '0%';
    bar.className      = 'sim-bar ' + cls;
    bar.textContent    = hasInput ? formatCurrency(value) : '';
}

// ===================================================================
//  VOLUME DISCOUNT TABLE — FIX #4: IDs flexíveis
// ===================================================================
function updateVolumeTable() {
    const unitPrice      = _lastUnitPrice || 0;
    const wholesalePrice = getNum('sim_wholesale_price');

    const tier1 = unitPrice;
    const tier2 = unitPrice * 0.85;
    const tier3 = wholesalePrice > 0 ? wholesalePrice : (unitPrice * 0.70);

    // Tenta os dois padrões de ID (vol_tier1 e vol_tier1_price)
    setText('vol_tier1',       formatCurrency(tier1));
    setText('vol_tier1_price', formatCurrency(tier1));
    setText('vol_tier2',       formatCurrency(tier2));
    setText('vol_tier2_price', formatCurrency(tier2));
    setText('vol_tier3',       formatCurrency(tier3));
    setText('vol_tier3_price', formatCurrency(tier3));

    const badge = document.getElementById('vol_tier3_badge');
    if (badge) {
        if (wholesalePrice > 0 && unitPrice > 0) {
            const disc = ((unitPrice - wholesalePrice) / unitPrice) * 100;
            badge.textContent = `-${disc.toFixed(0)}%`;
        } else {
            badge.textContent = '-30%';
        }
    }
}

// ===================================================================
//  MAIN CALCULATOR — FIX #1 #2 #4
// ===================================================================
let _lastFinalPrice = 0;  // Preço final do LOTE
let _lastUnitPrice  = 0;  // Preço final UNITÁRIO
let _lastUnitCost   = 0;  // Custo UNITÁRIO (sem margem)
let _lastTotalCost  = 0;  // Custo total do LOTE

function initCalculator() {
    const reactiveFields = [
        'filament_price_kg',
        'piece_weight_g',
        'batch_qty',            // ★ NOVO
        'print_hours',
        'print_minutes',
        'manual_hours',
        'manual_minutes',
        'depreciation_per_hour',
        'labor_per_hour',
        'risk_rate',
        'margin_percent',
    ];

    reactiveFields.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('input', () => calculate());

        if (id.includes('minutes')) {
            el.addEventListener('blur', function () {
                let v = parseInt(this.value) || 0;
                if (v > 59) this.value = 59;
                if (v < 0)  this.value = 0;
                calculate();
            });
        }
    });
}

function calculate() {
    // ========== Gather inputs ==========
    const filamentPriceKg = getNum('filament_price_kg');
    const pieceWeightG    = getNum('piece_weight_g');
    const batchQty        = Math.max(Math.floor(getNum('batch_qty')), 1);  // ★ Lote
    const printTimeH      = getTimeH('print_hours', 'print_minutes');
    const manualTimeH     = getTimeH('manual_hours', 'manual_minutes');
    const depreciationH   = getNum('depreciation_per_hour');
    const laborH          = getNum('labor_per_hour');
    const riskRate        = getNum('risk_rate');
    const marginPercent   = getNum('margin_percent');
    const suppliesCost    = parseFloat(document.getElementById('supplies_cost')?.value) || 0;
    const valueMultiplier = Math.max(parseFloat(document.getElementById('value_multiplier')?.value) || 1, 1);

    // ========== Constants ==========
    const energyTariff       = 0.85;   // R$/kWh
    const printerConsumption = 0.12;   // kW

    // ========== Custos do LOTE inteiro ==========
    // (peso, tempo e energia referem-se à produção completa do lote)
    const filamentCost     = (pieceWeightG / 1000) * filamentPriceKg;
    const energyCost       = printTimeH * printerConsumption * energyTariff;
    const depreciationCost = printTimeH * depreciationH;
    const laborCost        = manualTimeH * laborH;

    // Insumos: custo POR PEÇA × qtd lote
    const suppliesCostBatch = suppliesCost * batchQty;

    const subtotalBatch = filamentCost + energyCost + depreciationCost + laborCost + suppliesCostBatch;
    const riskCost      = subtotalBatch * (riskRate / 100);
    const totalCostBatch = subtotalBatch + riskCost;

    // ========== Custo UNITÁRIO ==========
    const unitCost = totalCostBatch / batchQty;

    // ========== Preço final ==========
    const mult = valueMultiplier;
    const finalPriceBatch = totalCostBatch * (1 + marginPercent / 100) * mult;
    const unitPrice       = finalPriceBatch / batchQty;

    // Preço-sugestão cards (baseados no custo UNITÁRIO)
    const price100 = unitCost * 2 * mult;
    const price200 = unitCost * 3 * mult;
    const price400 = unitCost * 5 * mult;

    // ========== Guardar para simulador ==========
    _lastFinalPrice = finalPriceBatch;
    _lastUnitPrice  = unitPrice;
    _lastUnitCost   = unitCost;
    _lastTotalCost  = totalCostBatch;

    // ========== Atualizar hidden trackers ==========
    setVal('print_time_h',    printTimeH.toFixed(4));
    setVal('manual_time_h',   manualTimeH.toFixed(4));
    setVal('calc_total_cost', totalCostBatch.toFixed(4));
    setVal('batch_qty_hidden', batchQty);

    // ========== FIX #4 — Decomposição do Custo ==========
    // Tenta AMBOS os padrões (bd_ e res_) para cobrir qualquer template
    const breakdown = {
        filament:     formatCurrency(filamentCost),
        energy:       formatCurrency(energyCost),
        depreciation: formatCurrency(depreciationCost),
        labor:        formatCurrency(laborCost),
        supplies:     formatCurrency(suppliesCostBatch),
        risk:         formatCurrency(riskCost),
        total:        formatCurrency(totalCostBatch),
    };

    Object.entries(breakdown).forEach(([key, val]) => {
        setText(`bd_${key}`,  val);   // padrão bd_*
        setText(`res_${key}`, val);   // padrão res_*
    });

    // Custo unitário na decomposição
    setText('bd_unit_cost', formatCurrency(unitCost));

    // ========== Preço Final (botão verde) ==========
    setText('res_final_price', formatCurrency(finalPriceBatch));

    // Mostrar/ocultar linha de preço unitário
    const unitRow = document.getElementById('unit_price_row');
    if (unitRow) {
        if (batchQty > 1) {
            unitRow.classList.remove('hidden');
            setText('res_unit_price', formatCurrency(unitPrice));
        } else {
            unitRow.classList.add('hidden');
        }
    }

    // Cards de sugestão de preço (são por unidade)
    setText('res_price100', formatCurrency(price100));
    setText('res_price200', formatCurrency(price200));
    setText('res_price400', formatCurrency(price400));

    // ========== Labels dinâmicos ==========
    setText('risk_label',   `(${riskRate}%)`);
    setText('margin_label', `${marginPercent}%`);

    const multLabel = document.getElementById('mult_label');
    if (multLabel) multLabel.textContent = mult > 1 ? ` × ${mult}x` : '';

    // Label de lote
    const batchLabel = document.getElementById('batch_label');
    if (batchLabel) {
        batchLabel.textContent = batchQty > 1 ? `Lote de ${batchQty} peças` : '';
    }

    setTimeLabel('print_time_label',  printTimeH);
    setTimeLabel('manual_time_label', manualTimeH);

    // ========== Populate hidden form fields for submission ==========
    setVal('h_piece_name',        document.getElementById('piece_name_input')?.value || '');
    setVal('h_total_cost',        totalCostBatch.toFixed(2));
    setVal('h_final_price',       finalPriceBatch.toFixed(2));
    setVal('h_filament_cost',     filamentCost.toFixed(2));
    setVal('h_energy_cost',       energyCost.toFixed(2));
    setVal('h_depreciation_cost', depreciationCost.toFixed(2));
    setVal('h_labor_cost',        laborCost.toFixed(2));
    setVal('h_supplies_cost',     suppliesCostBatch.toFixed(2));
    setVal('h_print_time',        printTimeH.toFixed(2));
    setVal('h_unit_cost',         unitCost.toFixed(2));
    setVal('h_unit_price',        unitPrice.toFixed(2));

    // ========== Cascade ==========
    updateSimulator();
    updateVolumeTable();
}

// ===================================================================
//  HELPERS
// ===================================================================
function getNum(id) {
    const el = document.getElementById(id);
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isNaN(v) ? 0 : v;
}

function getTimeH(hId, mId) {
    return getNum(hId) + (getNum(mId) / 60);
}

function formatCurrency(value) {
    const abs = Math.abs(value);
    return (value < 0 ? '-R$ ' : 'R$ ') + abs.toFixed(2);
}

/** Seta textContent de um elemento. Não faz nada se o ID não existir. */
function setText(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
}

/** Seta .value de um input/hidden. */
function setVal(id, value) {
    const el = document.getElementById(id);
    if (el) el.value = value;
}

function setTimeLabel(id, decH) {
    const el = document.getElementById(id);
    if (!el) return;
    const h = Math.floor(decH);
    const m = Math.round((decH - h) * 60);
    if (h === 0 && m === 0) el.textContent = '';
    else if (h === 0)       el.textContent = `= ${m}min`;
    else if (m === 0)       el.textContent = `= ${h}h`;
    else                    el.textContent = `= ${h}h ${m}min`;
}

// ===================================================================
//  TOASTS
// ===================================================================
function initToasts() {
    const p = new URLSearchParams(window.location.search);
    let msg = null;
    if (p.has('saved'))          msg = '✅ Orçamento salvo com sucesso!';
    if (p.has('deleted'))        msg = '🗑️ Item removido!';
    if (p.has('cleared'))        msg = '🧹 Histórico limpo!';
    if (p.has('added'))          msg = '✅ Item adicionado!';
    if (p.has('settings_saved')) msg = '⚙️ Configurações atualizadas!';
    if (msg) {
        showToast(msg);
        window.history.replaceState({}, '', window.location.pathname);
    }
}

function showToast(message) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.textContent = message;
    document.body.appendChild(t);
    setTimeout(() => { if (t.parentNode) t.remove(); }, 3200);
}

// ===================================================================
//  BUTTON FEEDBACK
// ===================================================================
function initButtonFeedback() {
    document.querySelectorAll('.btn').forEach(btn => {
        btn.addEventListener('mousedown',  () => btn.style.transform = 'scale(0.95)');
        btn.addEventListener('mouseup',    () => btn.style.transform = '');
        btn.addEventListener('mouseleave', () => btn.style.transform = '');
    });
}

// ===================================================================
//  CONFIRM DIALOGS
// ===================================================================
function confirmDelete(msg) {
    return confirm(msg || 'Tem certeza que deseja remover este item?');
}
function confirmClear() {
    return confirm('⚠️ Isso removerá TODOS os orçamentos do histórico. Continuar?');
}
