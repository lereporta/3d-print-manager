{% extends "base.html" %}
{% set active_page = "dashboard" %}

{% block title %}Dashboard - 3D Print Manager{% endblock %}
{% block page_title %}
    <span class="flex items-center gap-2">
        <svg class="w-6 h-6 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Dashboard
    </span>
{% endblock %}

{% block content %}
<!-- Stats Row -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="card stat-card purple">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Orçamentos</p>
        <p class="text-2xl font-extrabold">{{ stats.total_budgets }}</p>
        <p class="text-xs text-gray-400 mt-1">Total registrado</p>
    </div>
    <div class="card stat-card cyan">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Pendentes</p>
        <p class="text-2xl font-extrabold text-amber-500">{{ stats.pending_jobs }}</p>
        <p class="text-xs text-gray-400 mt-1">Na fila</p>
    </div>
    <div class="card stat-card green">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Imprimindo</p>
        <p class="text-2xl font-extrabold text-blue-500">{{ stats.printing_jobs }}</p>
        <p class="text-xs text-gray-400 mt-1">Em andamento</p>
    </div>
    <div class="card stat-card amber">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Filamento</p>
        <p class="text-2xl font-extrabold">R$ {{ "%.2f"|format(settings.filament_price_kg) }}</p>
        <p class="text-xs text-gray-400 mt-1">Por KG (último salvo)</p>
    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

    <!-- ==================== LEFT: CALCULATOR ==================== -->
    <div class="xl:col-span-2 space-y-6">
        <div class="card">
            <div class="flex items-center gap-2 mb-6">
                <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="text-lg font-bold">Calculadora de Precificação</h3>
            </div>

            <form method="POST" action="/calculator" id="calc-form">
                <!-- Hidden fields for computed values -->
                <input type="hidden" name="print_time_h" id="print_time_h" value="0">
                <input type="hidden" name="manual_time_h" id="manual_time_h" value="0">
                <input type="hidden" name="supplies_cost" id="supplies_cost" value="0">
                <input type="hidden" name="value_multiplier" id="value_multiplier" value="1">
                <input type="hidden" id="calc_total_cost" value="0">
                <input type="hidden" name="lot_quantity" id="lot_quantity_hidden" value="1">
                <input type="hidden" name="unit_cost" id="h_unit_cost" value="0">
                <input type="hidden" name="unit_price" id="h_unit_price" value="0">

                <!-- Piece Name -->
                <div class="mb-5">
                    <label class="block text-sm font-semibold mb-1.5">
                        Nome da Peça <span class="text-gray-400 font-normal">(opcional)</span>
                    </label>
                    <input type="text" name="piece_name" placeholder="Ex: Suporte para celular" class="input-field">
                </div>

                <!-- ===== SECTION: Material & Peso ===== -->
                <div class="section-divider">
                    <span>🧵 Material & Peso</span>
                </div>

                <!-- Spool Selector -->
                <div class="mb-4">
                    <label class="block text-sm font-semibold mb-1.5">🧵 Selecionar Carretel do Inventário</label>
                    <select id="spool_selector" class="input-field" onchange="onSpoolSelect(this)">
                        <option value="">— Manual (digitar preço) —</option>
                    </select>
                    <p class="text-xs text-gray-400 mt-1">Selecione um carretel para puxar o preço automaticamente</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-2">
                    <div>
                        <label class="block text-sm font-semibold mb-1.5">Preço do KG do Filamento</label>
                        <div class="input-group">
                            <span class="input-prefix">R$</span>
                            <input type="number" step="0.01" min="0"
                                   name="filament_price_kg" id="filament_price_kg"
                                   value="{{ settings.filament_price_kg }}"
                                   class="input-field has-prefix" placeholder="120.00" required>
                        </div>
                        <p class="text-xs text-gray-400 mt-1" id="price_source_hint">💾 Persistido no navegador</p>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1.5">Peso Total</label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="0"
                                   name="piece_weight_g" id="piece_weight_g"
                                   value="0" class="input-field has-suffix" placeholder="200" required>
                            <span class="input-suffix">gramas</span>
                        </div>
                        <p class="text-xs text-gray-400 mt-1" id="weight_hint">Peso total da impressão</p>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1.5">Peças no Lote</label>
                        <div class="input-group">
                            <input type="number" step="1" min="1"
                                   name="lot_quantity" id="lot_quantity"
                                   value="1" class="input-field has-suffix" placeholder="1" required>
                            <span class="input-suffix">un</span>
                        </div>
                        <p class="text-xs text-gray-400 mt-1" id="lot_hint">Quantas peças saem dessa impressão</p>
                    </div>
                </div>

                <!-- ===== SECTION: Tempos ===== -->
                <div class="section-divider">
                    <span>⏱️ Tempos</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-2">
                    <div>
                        <label class="block text-sm font-semibold mb-1.5">
                            Tempo de Impressão
                            <span id="print_time_label" class="text-xs text-indigo-400 font-normal ml-1"></span>
                        </label>
                        <div class="time-pair">
                            <div class="input-group">
                                <input type="number" step="1" min="0" max="999"
                                       id="print_hours" value="0"
                                       class="input-field has-suffix" placeholder="2">
                                <span class="input-suffix">h</span>
                            </div>
                            <div class="input-group">
                                <input type="number" step="1" min="0" max="59"
                                       id="print_minutes" value="0"
                                       class="input-field has-suffix" placeholder="30">
                                <span class="input-suffix">min</span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1.5">
                            Trabalho Manual (acabamento)
                            <span id="manual_time_label" class="text-xs text-indigo-400 font-normal ml-1"></span>
                        </label>
                        <div class="time-pair">
                            <div class="input-group">
                                <input type="number" step="1" min="0" max="999"
                                       id="manual_hours" value="0"
                                       class="input-field has-suffix" placeholder="0">
                                <span class="input-suffix">h</span>
                            </div>
                            <div class="input-group">
                                <input type="number" step="1" min="0" max="59"
                                       id="manual_minutes" value="0"
                                       class="input-field has-suffix" placeholder="15">
                                <span class="input-suffix">min</span>
                            </div>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">Fatiamento, limpeza, montagem, pintura</p>
                    </div>
                </div>

                <!-- ===== SECTION: Insumos de Montagem ===== -->
                <div class="section-divider">
                    <span>📦 Insumos de Montagem (Custos Invisíveis)</span>
                </div>

                <div class="p-4 rounded-lg bg-gray-50 dark:bg-slate-800/50 mb-2">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Insumos Adicionais</p>
                            <span id="supply-count" class="text-xs text-indigo-400 font-semibold"></span>
                        </div>
                        <button type="button" id="add-supply-btn"
                                class="btn btn-ghost btn-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                            Adicionar
                        </button>
                    </div>

                    <div id="supplies-container">
                        <!-- Dynamic supply rows added here by JS -->
                    </div>

                    <p id="supplies-placeholder" class="text-xs text-gray-400 text-center py-3" style="display:block;">
                        Nenhum insumo adicionado. Clique em "Adicionar" para incluir parafusos, ímãs, argolas, etc.
                    </p>

                    <div class="flex justify-between items-center mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                        <span class="text-xs font-semibold text-gray-500">📦 Custo Total dos Insumos</span>
                        <span id="res_supplies" class="text-sm font-bold text-indigo-500">R$ 0.00</span>
                    </div>
                </div>

                <!-- ===== SECTION: Parâmetros Ajustáveis ===== -->
                <div class="section-divider">
                    <span>⚙️ Parâmetros Ajustáveis</span>
                </div>

                <div class="p-4 rounded-lg bg-gray-50 dark:bg-slate-800/50 mb-2">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <label class="block text-xs font-semibold mb-1.5">Depreciação</label>
                            <div class="input-group">
                                <span class="input-prefix">R$</span>
                                <input type="number" step="0.01" min="0"
                                       name="depreciation_per_hour" id="depreciation_per_hour"
                                       value="{{ settings.depreciation_per_hour }}"
                                       class="input-field has-prefix has-suffix" required>
                                <span class="input-suffix">/h</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold mb-1.5">Mão de Obra</label>
                            <div class="input-group">
                                <span class="input-prefix">R$</span>
                                <input type="number" step="0.01" min="0"
                                       name="labor_per_hour" id="labor_per_hour"
                                       value="{{ settings.labor_per_hour }}"
                                       class="input-field has-prefix has-suffix" required>
                                <span class="input-suffix">/h</span>
                            </div>
                            <p class="text-xs text-gray-400 mt-1">💾 Persistido</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold mb-1.5">Taxa de Risco</label>
                            <div class="input-group">
                                <input type="number" step="0.5" min="0" max="100"
                                       name="risk_rate" id="risk_rate"
                                       value="10"
                                       class="input-field has-suffix" required>
                                <span class="input-suffix">%</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold mb-1.5">Margem de Lucro</label>
                            <div class="input-group">
                                <input type="number" step="1" min="0" max="9999"
                                       name="margin_percent" id="margin_percent"
                                       value="100"
                                       class="input-field has-suffix" required>
                                <span class="input-suffix">%</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-4 text-xs text-gray-400">
                        <span class="flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
                            Energia: R$ 0,85/kWh
                        </span>
                        <span class="flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                            Consumo: 0,12 kW
                        </span>
                        <span class="flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-green-400"></span>
                            💾 Valores persistidos no navegador
                        </span>
                    </div>
                </div>

                <!-- ===== SECTION: Value Multiplier Toggle ===== -->
                <div class="section-divider">
                    <span>💎 Valor Agregado</span>
                </div>

                <div class="p-4 rounded-lg bg-gray-50 dark:bg-slate-800/50 mb-5">
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <p class="text-sm font-bold">Peça Técnica / Alto Valor Agregado</p>
                            <p class="text-xs text-gray-400 mt-0.5">
                                Para peças de reposição ou soluções que valem mais que o custo do material
                            </p>
                        </div>
                        <div id="value-toggle" class="toggle-switch" role="button" aria-label="Ativar multiplicador"></div>
                    </div>

                    <div id="value-multiplier-panel" style="display: none;" class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                        <label class="block text-xs font-semibold mb-1.5">Multiplicador de Valor</label>
                        <div class="grid grid-cols-5 gap-2">
                            <div class="col-span-2">
                                <div class="input-group">
                                    <input type="number" step="0.5" min="1" max="20"
                                           id="value_multiplier_input" value="1"
                                           class="input-field has-suffix" placeholder="2">
                                    <span class="input-suffix">×</span>
                                </div>
                            </div>
                            <div class="col-span-3 flex items-center gap-2">
                                <button type="button" onclick="document.getElementById('value_multiplier_input').value='1.5';document.getElementById('value_multiplier').value='1.5';calculate();"
                                        class="btn btn-ghost btn-sm flex-1">1.5×</button>
                                <button type="button" onclick="document.getElementById('value_multiplier_input').value='2';document.getElementById('value_multiplier').value='2';calculate();"
                                        class="btn btn-ghost btn-sm flex-1">2×</button>
                                <button type="button" onclick="document.getElementById('value_multiplier_input').value='3';document.getElementById('value_multiplier').value='3';calculate();"
                                        class="btn btn-ghost btn-sm flex-1">3×</button>
                                <button type="button" onclick="document.getElementById('value_multiplier_input').value='5';document.getElementById('value_multiplier').value='5';calculate();"
                                        class="btn btn-ghost btn-sm flex-1">5×</button>
                            </div>
                        </div>
                        <p class="text-xs text-gray-400 mt-2">
                            💡 Multiplica o preço final. Uma peça de reposição que evita R$ 500 de conserto vale mais que R$ 5 de filamento.
                        </p>
                    </div>
                </div>

                <!-- ===== RESULTS: Cost Breakdown ===== -->
                <div class="card result-glow mb-5 border-indigo-200 dark:border-indigo-800">
                    <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3">📊 Decomposição do Custo</p>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between"><span class="text-gray-500">🧵 Filamento</span><span id="res_filament" class="font-semibold">R$ 0.00</span></div>
                        <div class="flex justify-between"><span class="text-gray-500">⚡ Energia Elétrica</span><span id="res_energy" class="font-semibold">R$ 0.00</span></div>
                        <div class="flex justify-between"><span class="text-gray-500">🔧 Depreciação</span><span id="res_depreciation" class="font-semibold">R$ 0.00</span></div>
                        <div class="flex justify-between"><span class="text-gray-500">👷 Mão de Obra</span><span id="res_labor" class="font-semibold">R$ 0.00</span></div>
                        <div class="flex justify-between"><span class="text-gray-500">📦 Insumos</span><span id="res_supplies_breakdown" class="font-semibold">R$ 0.00</span></div>
                        <hr class="border-gray-200 dark:border-gray-700">
                        <div class="flex justify-between"><span class="text-gray-500">Subtotal</span><span id="res_subtotal" class="font-semibold">R$ 0.00</span></div>
                        <div class="flex justify-between">
                            <span class="text-gray-500">⚠️ Taxa de Risco <span id="risk_label">(10%)</span></span>
                            <span id="res_risk" class="font-semibold text-amber-500">R$ 0.00</span>
                        </div>
                        <hr class="border-gray-200 dark:border-gray-700">
                        <div class="flex justify-between text-base pt-1">
                            <span class="font-bold">💰 Custo Total</span>
                            <div class="text-right">
                                <span id="res_total" class="font-extrabold text-indigo-500 text-lg">R$ 0.00</span>
                                <span id="res_total_unit" class="text-xs text-gray-400 hidden ml-1"></span>
                            </div>
                        </div>
                        <div id="unit_cost_row" class="flex justify-between pt-1 hidden">
                            <span class="text-gray-500">📦 Custo por Peça</span>
                            <span id="res_unit_cost" class="font-bold text-cyan-500">R$ 0.00</span>
                        </div>
                    </div>
                </div>

                <!-- ===== RESULTS: Final Price ===== -->
                <div class="price-card custom-margin mb-4">
                    <p class="text-sm font-bold uppercase mb-1 opacity-90">
                        💵 Preço Final (Margem <span id="margin_label">100%</span><span id="mult_label"></span>)
                        <span id="batch_label" class="text-xs font-normal opacity-70"></span>
                    </p>
                    <p id="res_final_price" class="text-3xl font-extrabold">R$ 0.00</p>
                    <p class="text-xs opacity-70 mt-1">Este valor será salvo no orçamento</p>
                    <div id="lot_price_subtitle" class="hidden mt-2 pt-2 border-t border-white/20">
                        <p class="text-xs opacity-70">Preço Total do Lote</p>
                        <p id="res_lot_total_price" class="text-xl font-bold">R$ 0.00</p>
                    </div>
                </div>

                <!-- Reference Prices -->
                <div class="grid grid-cols-3 gap-3 mb-5">
                    <div class="price-card silver">
                        <p class="text-xs font-bold uppercase mb-1 opacity-80">Ref. 100%</p>
                        <p id="res_price100" class="text-lg font-extrabold">R$ 0.00</p>
                    </div>
                    <div class="price-card gold">
                        <p class="text-xs font-bold uppercase mb-1 opacity-80">Ref. 200%</p>
                        <p id="res_price200" class="text-lg font-extrabold">R$ 0.00</p>
                    </div>
                    <div class="price-card platinum">
                        <p class="text-xs font-bold uppercase mb-1 opacity-80">Ref. 400%</p>
                        <p id="res_price400" class="text-lg font-extrabold">R$ 0.00</p>
                    </div>
                </div>

                <!-- ===== VOLUME DISCOUNT TABLE ===== -->
                <div class="card mb-5 border-blue-200 dark:border-blue-900">
                    <div class="flex items-center gap-2 mb-3">
                        <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                        </svg>
                        <p class="text-sm font-bold">📦 Tabela de Descontos por Volume</p>
                    </div>
                    <table class="volume-table">
                        <thead>
                            <tr>
                                <th>Qtd</th>
                                <th>Nível</th>
                                <th>Preço Un.</th>
                                <th>Desconto</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="font-semibold">1 – 10</td>
                                <td><span class="tier-badge tier-1">Varejo</span></td>
                                <td class="font-bold" id="vol_tier1_price">R$ 0.00</td>
                                <td class="text-gray-400">—</td>
                            </tr>
                            <tr>
                                <td class="font-semibold">11 – 30</td>
                                <td><span class="tier-badge tier-2">Semi-atacado</span></td>
                                <td class="font-bold" id="vol_tier2_price">R$ 0.00</td>
                                <td class="font-semibold text-amber-500" id="vol_tier2_discount">-15%</td>
                            </tr>
                            <tr>
                                <td class="font-semibold">40+</td>
                                <td><span class="tier-badge tier-3">Atacado</span></td>
                                <td class="font-bold" id="vol_tier3_price">R$ 0.00</td>
                                <td class="font-semibold text-emerald-500" id="vol_tier3_discount">-30%</td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-xs text-gray-400 mt-2">💡 O preço "Atacado" usa o valor definido no simulador abaixo, se preenchido.</p>
                </div>

                <!-- ===== WHOLESALE SIMULATOR ===== -->
                <div class="card mb-6 border-purple-200 dark:border-purple-900">
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        <p class="text-sm font-bold">📊 Simulador de Revenda / Atacado</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold mb-1.5">Preço no Mercado (Varejo)</label>
                            <div class="input-group">
                                <span class="input-prefix">R$</span>
                                <input type="number" step="0.01" min="0"
                                       id="sim_retail_price" value="0"
                                       class="input-field has-prefix" placeholder="50.00">
                            </div>
                            <p class="text-xs text-gray-400 mt-1">Preço que o cliente final paga</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold mb-1.5">Sua Oferta Atacado</label>
                            <div class="input-group">
                                <span class="input-prefix">R$</span>
                                <input type="number" step="0.01" min="0"
                                       id="sim_wholesale_price" value="0"
                                       class="input-field has-prefix" placeholder="25.00">
                            </div>
                            <p class="text-xs text-gray-400 mt-1">Preço de venda para revendedores</p>
                        </div>
                    </div>

                    <!-- Alert -->
                    <div id="sim_alert" style="display:none;"
                         class="mb-4 p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 flex items-center gap-2">
                        <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                        </svg>
                        <p class="text-sm font-bold text-red-600 dark:text-red-400">
                            ⚠️ PREJUÍZO! O preço de atacado está abaixo do custo total da peça.
                        </p>
                    </div>

                    <!-- Profit Display -->
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div class="p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/15 text-center">
                            <p class="text-xs font-semibold text-gray-500 mb-1">Seu Lucro / Peça</p>
                            <p id="sim_your_profit" class="text-lg font-extrabold text-emerald-500">R$ 0.00</p>
                        </div>
                        <div class="p-3 rounded-lg bg-indigo-50 dark:bg-indigo-900/15 text-center">
                            <p class="text-xs font-semibold text-gray-500 mb-1">Lucro do Revendedor</p>
                            <p id="sim_reseller_profit" class="text-lg font-extrabold text-indigo-500">R$ 0.00</p>
                        </div>
                    </div>

                    <!-- Visual Bars -->
                    <div class="space-y-2">
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-gray-500 font-semibold">Seu Lucro</span>
                            </div>
                            <div class="w-full bg-gray-100 dark:bg-slate-800 rounded-lg overflow-hidden">
                                <div id="sim_your_bar" class="sim-bar profit" style="width: 0%">R$ 0.00</div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs mb-1">
                                <span class="text-gray-500 font-semibold">Lucro do Revendedor</span>
                            </div>
                            <div class="w-full bg-gray-100 dark:bg-slate-800 rounded-lg overflow-hidden">
                                <div id="sim_reseller_bar" class="sim-bar reseller" style="width: 0%">R$ 0.00</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn btn-primary w-full py-3 text-base">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                    </svg>
                    Salvar Orçamento
                </button>
            </form>
        </div>
    </div>

    <!-- ==================== RIGHT COLUMN ==================== -->
    <div class="space-y-6">

        <!-- ROI / Depreciation Fund -->
        <div class="card stat-card red">
            <div class="flex items-center gap-2 mb-4">
                <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <h3 class="font-bold">Fundo de Depreciação</h3>
            </div>

            <form method="POST" action="/settings/machine" class="mb-4">
                <label class="block text-xs font-semibold mb-1.5">Custo da Máquina</label>
                <div class="flex gap-2">
                    <div class="input-group flex-1">
                        <span class="input-prefix">R$</span>
                        <input type="number" step="0.01" min="0"
                               name="machine_cost" value="{{ roi.machine_cost }}"
                               class="input-field has-prefix" placeholder="2500.00">
                    </div>
                    <button type="submit" class="btn btn-ghost text-xs px-3" title="Salvar custo">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    </button>
                </div>
            </form>

            <div class="space-y-3">
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Depreciação Acumulada</span>
                    <span class="font-bold text-emerald-500">R$ {{ "%.2f"|format(roi.depreciation_total) }}</span>
                </div>
                {% if roi.machine_cost > 0 %}
                <div class="progress-bar">
                    <div class="progress-fill {% if roi.roi_percent >= 100 %}bg-emerald-500{% else %}bg-indigo-500{% endif %}"
                         style="width: {{ [roi.roi_percent, 100]|min }}%"></div>
                </div>
                <div class="flex justify-between text-xs">
                    <span class="text-gray-400">{{ roi.roi_percent }}% amortizado</span>
                    <span class="text-gray-400">Meta: R$ {{ "%.2f"|format(roi.machine_cost) }}</span>
                </div>
                {% if roi.roi_percent >= 100 %}
                <div class="mt-2 p-2 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 text-center">
                    <p class="text-sm font-bold text-emerald-600 dark:text-emerald-400">🎉 Máquina 100% amortizada!</p>
                </div>
                {% endif %}
                {% else %}
                <p class="text-xs text-gray-400">Defina o custo da máquina para acompanhar o ROI.</p>
                {% endif %}
            </div>
        </div>

        <!-- Recent Budgets -->
        <div class="card">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold">Orçamentos Recentes</h3>
                <a href="/history/" class="text-xs text-indigo-500 hover:underline font-semibold">Ver todos →</a>
            </div>
            {% if recent_budgets %}
            <div class="space-y-3">
                {% for b in recent_budgets %}
                <div class="p-3 rounded-lg bg-gray-50 dark:bg-slate-800/50 flex justify-between items-center">
                    <div>
                        <p class="font-semibold text-sm">{{ b.piece_name }}</p>
                        <div class="flex gap-2 mt-0.5">
                            <span class="text-xs text-gray-400">{{ b.created_at.strftime('%d/%m/%Y %H:%M') }}</span>
                            {% if b.value_multiplier and b.value_multiplier > 1 %}
                            <span class="badge badge-urgent" style="font-size:0.65rem;padding:0.1rem 0.4rem;">{{ b.value_multiplier }}×</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-gray-400">Preço Final</p>
                        <p class="font-bold text-emerald-500">R$ {{ "%.2f"|format(b.final_price) }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="text-center py-8">
                <svg class="w-12 h-12 mx-auto text-gray-300 dark:text-gray-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                <p class="text-sm text-gray-400">Nenhum orçamento ainda</p>
            </div>
            {% endif %}
        </div>

        <!-- Formula Reference -->
        <div class="card">
            <h3 class="font-bold mb-3">📐 Fórmula</h3>
            <div class="text-xs text-gray-500 space-y-2 leading-relaxed">
                <p><strong>🧵 Filamento:</strong> (Peso ÷ 1000) × Preço/KG</p>
                <p><strong>⚡ Energia:</strong> T. Impressão × 0.12kW × R$0.85</p>
                <p><strong>🔧 Depreciação:</strong> T. Impressão × R$/h</p>
                <p><strong>👷 Mão de Obra:</strong> T. Manual × R$/h</p>
                <p><strong>📦 Insumos:</strong> Σ(Custo÷Qtd × Qtd/Peça)</p>
                <p><strong>⚠️ Risco:</strong> Subtotal × Taxa%</p>
                <hr class="border-gray-200 dark:border-gray-700">
                <p><strong>💵 Preço Final:</strong> Custo × (1 + Margem%) × Multiplicador</p>
            </div>
        </div>

        <!-- Pricing Tips -->
        <div class="card">
            <h3 class="font-bold mb-3">💡 Dicas de Precificação</h3>
            <div class="space-y-3 text-xs text-gray-500">
                <div class="p-2 rounded-lg bg-blue-50 dark:bg-blue-900/15">
                    <p class="font-bold text-blue-600 dark:text-blue-400 mb-0.5">Peças de Reposição</p>
                    <p>Use o multiplicador 3-5×. O cliente paga pela solução, não pelo plástico.</p>
                </div>
                <div class="p-2 rounded-lg bg-amber-50 dark:bg-amber-900/15">
                    <p class="font-bold text-amber-600 dark:text-amber-400 mb-0.5">Atacado</p>
                    <p>Nunca venda abaixo do custo total. Use a tabela de volume como guia.</p>
                </div>
                <div class="p-2 rounded-lg bg-purple-50 dark:bg-purple-900/15">
                    <p class="font-bold text-purple-600 dark:text-purple-400 mb-0.5">Insumos</p>
                    <p>Parafusos, ímãs e argolas parecem baratos, mas somam 15-30% do custo.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Load spools from inventory API
let spoolsData = [];

async function loadSpools() {
    try {
        const resp = await fetch('/inventory/api/spools');
        if (resp.ok) {
            spoolsData = await resp.json();
            const sel = document.getElementById('spool_selector');
            if (!sel) return;
            // Clear existing options except first
            while (sel.options.length > 1) sel.remove(1);
            spoolsData.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.id;
                opt.textContent = `${s.name} — ${s.material} ${s.color} (R$ ${s.price_per_kg.toFixed(2)}/kg) [${s.remaining_percent}%]`;
                opt.dataset.price = s.price_per_kg;
                opt.dataset.color = s.color_hex;
                sel.appendChild(opt);
            });
        }
    } catch(e) {
        console.warn('Não foi possível carregar carretéis:', e);
    }
}

function onSpoolSelect(sel) {
    const opt = sel.options[sel.selectedIndex];
    if (opt && opt.dataset.price) {
        const price = parseFloat(opt.dataset.price);
        const priceField = document.getElementById('filament_price_kg');
        priceField.value = price.toFixed(2);
        document.getElementById('price_source_hint').innerHTML =
            '🔗 Preço do carretel: <strong>' + opt.textContent.split('—')[0].trim() + '</strong>';
        // Trigger calculation if function exists
        if (typeof calculate === 'function') calculate();
    } else {
        document.getElementById('price_source_hint').innerHTML = '💾 Persistido no navegador';
    }
}

document.addEventListener('DOMContentLoaded', loadSpools);
</script>

{% endblock %}

